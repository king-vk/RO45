
import heapq

graph = {
    'A': {'B': 1, 'C': 3},
    'B': {'D': 3, 'E': 1},
    'C': {'F': 5},
    'D': {'G': 2},
    'E': {'G': 3},
    'F': {'G': 2},
    'G': {}
}

h = {'A': 5, 'B': 4, 'C': 4, 'D': 2, 'E': 2, 'F': 2, 'G': 0}


def a_star(start, goal):
    pq = [(h[start], 0, start)]
    g = {start: 0}
    parent = {start: None}

    while pq:
        f, cost, node = heapq.heappop(pq)
        if node == goal:
            path = []
            while node is not None:
                path.append(node)
                node = parent[node]
            return path[::-1], cost

        for nxt, edge_cost in graph[node].items():
            new_cost = cost + edge_cost
            if nxt not in g or new_cost < g[nxt]:
                g[nxt] = new_cost
                parent[nxt] = node
                heapq.heappush(pq, (new_cost + h[nxt], new_cost, nxt))

    return None, None


path, cost = a_star('A', 'G')
print("A* Path:", " -> ".join(path))
print("Total Cost:", cost)
